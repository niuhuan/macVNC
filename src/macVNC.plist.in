<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.christianbeier.macvnc</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/macVNC.app/Contents/MacOS/macVNC</string>
        <string>-rfbport</string>
        <string>5901</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/macvnc.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/macvnc.err</string>
</dict>
</plist>
